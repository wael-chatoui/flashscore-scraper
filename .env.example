# ===========================================
# FlashScore Volleyball Scraper Configuration
# ===========================================

# Google Sheets Configuration
# ---------------------------
# Your spreadsheet ID from the URL: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
SPREADSHEET_ID=your_spreadsheet_id_here
# Second spreadsheet (client's original). Set same as SPREADSHEET_ID if using only one.
SPREADSHEET_ID_2=your_spreadsheet_id_here
# Third spreadsheet (backup/previous main).
SPREADSHEET_ID_3=your_spreadsheet_id_here

# Option 1: Path to credentials JSON file (for local development)
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Option 2: Inline JSON credentials (for Docker/cloud - paste entire JSON as single line)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Scraper Configuration
# ---------------------
# Set to 'false' to see the browser (useful for debugging)
HEADLESS=true

# Delay between match requests in milliseconds
REQUEST_DELAY=1000

# Maximum matches to process (0 = unlimited)
MAX_MATCHES=0

# Google Sheets Column Configuration
# ----------------------------------
# Column preset (determines which columns to fill):
#   'TRI BASE OU 4' - From PDF brief: A-H match info, M-O team A, X-Z team B, AJ-AL H2H
#   'CALCUL SET'    - From CSV: C-E team A, I-K team B, O-Q H2H
SHEET_PRESET=TRI BASE OU 4

# Override tab name (leave empty to use preset default)
SHEET_TAB_NAME=

# Starting row for data injection (default: 2, after header)
START_ROW=2
