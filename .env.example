# ===========================================
# FlashScore Volleyball Scraper Configuration
# ===========================================

# Google Sheets Configuration
# ---------------------------
# Your spreadsheet ID from the URL: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Separate spreadsheet for hockey (optional — falls back to SPREADSHEET_ID)
HOCKEY_SPREADSHEET_ID=

# Separate spreadsheet for football (optional — falls back to SPREADSHEET_ID)
FOOTBALL_SPREADSHEET_ID=

# Unified all-sports log spreadsheet (optional — set to enable cross-sport logging)
ALL_SPORTS_LOG_SPREADSHEET_ID=1gVjLZ59rfvllfzpLMPGOKrcnHnEjl1e2JGQ9GUP9Vq8

# Tab name in the all-sports log spreadsheet (default: Sheet1)
ALL_SPORTS_LOG_SHEET_TAB=Feuille 1

# Option 1: Path to credentials JSON file (for local development)
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Option 2: Inline JSON credentials (for Docker/cloud - paste entire JSON as single line)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Scraper Configuration
# ---------------------
# Sport to scrape: 'volleyball' or 'hockey'
SPORT=volleyball

# Set to 'false' to see the browser (useful for debugging)
HEADLESS=true

# Delay between match requests in milliseconds
REQUEST_DELAY=1000

# Maximum matches to process (0 = unlimited)
MAX_MATCHES=0

# Google Sheets Column Configuration
# ----------------------------------
# Column preset (determines which columns to fill):
#   'ORIGINAL'      - A-H match info, M-O team A, X-Z team B, AJ-AL H2H
#   'SCRAPING OU4'  - I-O match info, T-V team A, AE-AG team B, AJ-AL H2H
#   'CALCUL SET'    - C-E team A, I-K team B, O-Q H2H
SHEET_PRESET=ORIGINAL

# Override tab name (leave empty to use preset default)
SHEET_TAB_NAME=

# Starting row for data injection (default: 2, after header)
START_ROW=2
